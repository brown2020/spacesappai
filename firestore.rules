rules_version = '2';

// ============================================================================
// FIRESTORE SECURITY RULES FOR SPACES APP
// ============================================================================
//
// Data Model:
//   documents/{documentId}          - Document metadata (title, timestamps)
//   users/{uid}/rooms/{docId}       - User's access to documents (role-based)
//
// Roles:
//   owner  - Can read, write, delete document; manage users
//   editor - Can read and write document content
//   viewer - Can read document content only
//
// Membership rows (users/{uid}/rooms/{docId}) are written only by the Admin SDK.
// Client creates of those rows were able to self-assign role "owner".
// Comment writes also go through the Admin SDK so authorName cannot be spoofed.
//
// Copy this entire file to Firebase Console > Firestore > Rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function hasRoomAccess(documentId) {
      return exists(/databases/$(database)/documents/users/$(getUserId())/rooms/$(documentId));
    }

    function getUserRole(documentId) {
      return get(/databases/$(database)/documents/users/$(getUserId())/rooms/$(documentId)).data.role;
    }

    function isOwner(documentId) {
      return hasRoomAccess(documentId) && getUserRole(documentId) == 'owner';
    }

    function canReadDocument(documentId) {
      return hasRoomAccess(documentId);
    }

    function canWriteDocument(documentId) {
      return hasRoomAccess(documentId)
        && (getUserRole(documentId) == 'owner' || getUserRole(documentId) == 'editor');
    }

    function isHttpsUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2000
        && value.matches('^https://.+');
    }

    function isValidDocumentData() {
      let data = request.resource.data;
      return data.keys().hasAll(['title'])
        && data.keys().hasOnly(['title', 'icon', 'coverImage', 'isPublished', 'createdAt', 'updatedAt', 'ownerId'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 500
        && (!('icon' in data) || data.icon == null || (data.icon is string && data.icon.size() <= 10))
        && (!('coverImage' in data) || data.coverImage == null || isHttpsUrl(data.coverImage))
        && (!('isPublished' in data) || data.isPublished is bool)
        && (!('ownerId' in data) || data.ownerId == null || (data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isPublishedFlag(data) {
      return data.get('isPublished', false) == true;
    }

    // ========================================================================
    // DOCUMENTS COLLECTION
    // ========================================================================

    match /documents/{documentId} {
      allow read: if isAuthenticated() && canReadDocument(documentId);

      // Client creates cannot publish or pin an owner id.
      // The Admin SDK bypasses these rules for createNewDocument().
      allow create: if isAuthenticated()
        && isValidDocumentData()
        && !isPublishedFlag(request.resource.data)
        && request.resource.data.get('ownerId', null) == null;

      // Editors may update content fields. Publishing and ownerId stay owner/server controlled.
      allow update: if isAuthenticated()
        && canWriteDocument(documentId)
        && isValidDocumentData()
        && request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && (
          isPublishedFlag(request.resource.data) == isPublishedFlag(resource.data)
          || isOwner(documentId)
        );

      allow delete: if isAuthenticated() && isOwner(documentId);

      // Comments are written by server actions (Admin SDK), which set author fields
      // from the verified session. Client writes could impersonate authorName.
      match /comments/{commentId} {
        allow read: if isAuthenticated() && canReadDocument(documentId);
        allow create, update, delete: if false;
      }
    }

    // ========================================================================
    // USERS COLLECTION (Room Access)
    // ========================================================================

    match /users/{uid} {
      allow read: if isAuthenticated() && getUserId() == uid;
      allow create, update, delete: if false;

      match /rooms/{roomId} {
        allow read: if isAuthenticated() && getUserId() == uid;

        // Do not allow clients to create, change, or delete role rows.
        // Self-service owner creates granted access to any document id.
        allow create, update, delete: if false;
      }
    }

    // ========================================================================
    // COLLECTION GROUP QUERIES
    // ========================================================================

    // Members can list collaborator rows for a document they can already access.
    match /{path=**}/rooms/{roomId} {
      allow read: if isAuthenticated() && hasRoomAccess(roomId);
    }
  }
}
